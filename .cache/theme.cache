/* ╔══════════════════════════╦═════════════════════════════════════════════════════════════════════════════[─]═[□]═[×]═╗ */
/* ║ Theme                    ║ Commands                                                                                ║ */
/* ╠══════════════════════════╩═════════════════════════════════════════════════════════════════════════════════════════╣ */
/* ║                                                                                                                    ║ */
/* ║ pnpm run watch                                                                                                     ║ */
/* ║                                                                                                                    ║ */
/* ║ This command uses the SASS compiler to continuously monitor changes in the src/scss/index.scss file and            ║ */
/* ║ automatically compile it into theme.css in compressed style when any changes occur.                                ║ */
/* ║ It doesn't generate source maps.                                                                                   ║ */
/* ║                                                                                                                    ║ */
/* ╠════════════════════════════════════════════════════════════════════════════════════════════════════════════════════╣ */
/* ║                                                                                                                    ║ */
/* ║ pnpm run version                                                                                                   ║ */
/* ║                                                                                                                    ║ */
/* ║ Runs a custom Node.js script that replaces versions in files based on the version in the manifest.json.            ║ */
/* ║                                                                                                                    ║ */
/* ╠════════════════════════════════════════════════════════════════════════════════════════════════════════════════════╣ */
/* ║                                                                                                                    ║ */
/* ║ pnpm run compile                                                                                                   ║ */
/* ║                                                                                                                    ║ */
/* ║ This command compiles the src/scss/index.scss file using the SASS compiler and creates src/css/main.css            ║ */
/* ║ without generating source maps.                                                                                    ║ */
/* ║                                                                                                                    ║ */
/* ╠════════════════════════════════════════════════════════════════════════════════════════════════════════════════════╣ */
/* ║                                                                                                                    ║ */
/* ║ pnpm run merge                                                                                                     ║ */
/* ║                                                                                                                    ║ */
/* ║ This command runs a Node.js script located at scripts/merge.js. The purpose of this script is not described        ║ */
/* ║ in the provided script commands, but it likely performs some sort of merging or processing operation.              ║ */
/* ║                                                                                                                    ║ */
/* ╠════════════════════════════════════════════════════════════════════════════════════════════════════════════════════╣ */
/* ║                                                                                                                    ║ */
/* ║ pnpm run build                                                                                                     ║ */
/* ║                                                                                                                    ║ */
/* ║ This is a composite command that combines multiple steps. It first runs the "compile" and "compile:min"            ║ */
/* ║ commands to generate both regular and minified CSS files. Then, it runs the "merge" command,                       ║ */
/* ║ which presumably does some post-processing or merging related to the previously generated CSS files.               ║ */
/* ║ This "build" command is likely intended for building the final version of your project.                            ║ */
/* ║ It uses pnpm to manage and run the sub-commands.                                                                   ║ */
/* ║                                                                                                                    ║ */
/* ╚════════════════════════════════════════════════════════════════════════════════════════════════════════════════════╝ */

/* ╔══════════════════════════╦═════════════════════════════════════════════════════════════════════════════[─]═[□]═[×]═╗ */
/* ║ Theme                    ║ Settings                                                                                ║ */
/* ╚══════════════════════════╩═════════════════════════════════════════════════════════════════════════════════════════╝ */

/* @settings

name: CreArts
id: crearts
settings:
    - 
        id: crearts-info
        title: Welcome to CreArts!
        title.de: Willkommen bei CreArts!
        description: With these settings you can customize the theme according to your wishes.
        description.de: Mit diesen Einstellungen können Sie das Thema nach Ihren Wünschen anpassen.
        type: info-text
        markdown: true
    -
        id: skins-dark
        title: Skins
        description: Here you have a choice of dark skins.
        description.de: Hier haben Sie eine Auswahl an dunklen Skins.
        type: class-select
        allowEmpty: false
        default: skin-dark-default
        options:
            - 
                label: Default
                value: skin-dark-default

            - 
                label: Cosmic
                value: skin-dark-cosmic

            - 
                label: GitHub
                value: skin-dark-github

            - 
                label: Goon
                value: skin-dark-goon

            - 
                label: Halcyon
                value: skin-dark-halcyon

            - 
                label: Lavender
                value: skin-dark-lavender

            - 
                label: Nebula
                value: skin-dark-nebula

            - 
                label: Notion
                value: skin-dark-notion

            - 
                label: Obsidian
                value: skin-dark-obsidian
    -
        id: skins-light
        title: Skins
        description: Here you have a choice of light skins.
        description.de: Hier haben Sie eine Auswahl an hellen Skins.
        type: class-select
        allowEmpty: false
        default: skin-light-default
        options:
            - 
                label: Default
                value: skin-light-default
    - 
        id: palette
        title: Palette
        description: "Choose from a variety of colors to customize the look of your user interface. From backgrounds to accents, everything is possible here."
        description.de: "Wählen Sie aus einer Vielzahl von Farben, um das Erscheinungsbild Ihrer Benutzeroberfläche individuell zu gestalten. Von Hintergründen bis zu Akzenten, hier ist alles möglich."
        description.ja: "様々な色から選んで、ユーザーインターフェースの外観をカスタマイズしましょう。背景からアクセントまで、ここですべてが可能です。"
        type: heading
        level: 1
        collapsed: true
    - 
        id: my-title
        title: Shape
        description: "Adjust spacing, corners, and radii to achieve a harmonious design. Round or square, design the user interface to your liking."
        description.de: "Passen Sie Abstände, Ecken und Radien an, um ein harmonisches Design zu erzielen. Ob rund oder eckig, gestalten Sie die Benutzeroberfläche nach Ihren Wünschen."
        description.ja: "間隔、コーナー、半径を調整し、調和のとれたデザインを実現。丸でも四角でも、お好みのユーザーインターフェイスをデザインしてください。"
        type: heading
        level: 1
        collapsed: true
    - 
        id: my-title
        title: Typography
        description: "Choose from different font styles and sizes to customize the text in your application. From headings to body text, everything is customizable."
        description.de: "Wählen Sie aus verschiedenen Schriftarten und -größen, um den Text in Ihrer Anwendung anzupassen. Von Überschriften bis zum Fließtext, alles ist anpassbar."
        description.ja: "さまざまなフォントスタイルとサイズから選択して、アプリケーションのテキストをカスタマイズできます。見出しから本文まで、すべてがカスタマイズ可能です。"
        type: heading
        level: 1
        collapsed: true
    - 
        id: features
        title: Features
        description: "Customize UI with Toggles. Enable or disable various options."
        description.de: "Passe die Benutzeroberfläche an. Aktiviere oder deaktiviere verschiedene Optionen."
        description.ja: "トグルでUIをカスタマイズ。様々なオプションを有効/無効にできます。"
        type: heading
        level: 1
        collapsed: true
    - 
        id: neumorphism
        title: Neumorphism
        description: Disable Neumorphism effect.
        type: class-toggle
        default: false
    - 
        id: pets
        title: Pets
        description: Enable Statusbar Pet.
        type: class-toggle
        default: false

*/

