  --SKIN-grading-interface-secondary: 16%;
  --SKIN-grading-interface-tertiary: 24%;
  }  
/* ╔═══════════════════════════════════════════════════════════════════════════╗ */
/* ║ Skin                                                                      ║ */
/* ╠══════════════════════════╦════════════════════════════════════════════════╣ */
/* ║ Skin:                    ║ Default Edition                                ║ */
/* ║ Author:                  ║ Corellan                                       ║ */
