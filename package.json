{
  "name": "crearts-obsidian-theme",
  "version": "1.0.0",
  "author": "corellan",
  "description": "CreArts is a customizable Obsidian theme that changes the appearance of Obsidian.",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "concurrently": "^10.0.5",
    "fs-extra": "^11.2.0",
    "jsonfile": "^6.2.1",
    "mini-svg-data-uri": "^1.4.4",
    "pnpm": "^8.15.9",
    "sass": "^1.81.0",
    "stylelint": "^15.11.0",
    "stylelint-config-recommended-scss": "^13.1.0",
    "stylelint-scss": "^5.3.2",
    "svgo": "^4.0.2"
  },
  "scripts": {
    "lint": "stylelint \"**/src/scss/**/*.scss\"",
    "compile": "sass --no-source-map src/scss/index.scss src/css/main.css",
    "compile:min": "sass --no-source-map src/scss/index.scss src/css/main.min.css --style compressed",
    "merge": "node scripts/merge.js",
    "skins": "node scripts/skins.js",
    "version": "node scripts/version.js",
    "svgo": "node scripts/svgo.js --write",
    "snippets": "node scripts/snippets.js",
    "snippets:watch": "node scripts/snippets.js --watch",
    "mobile": "node scripts/mobile.js",
    "mobile:watch": "node scripts/mobile.js --watch",
    "watch": "sass --no-source-map --watch src/scss/index.scss theme.css --style=expanded",
    "dev": "concurrently --kill-others \"pnpm run watch\" \"pnpm run snippets:watch\"",
    "build": "pnpm run version && pnpm run compile && pnpm run compile:min && pnpm run skins && pnpm run merge && pnpm run snippets"
  },
  "stylelint": {
    "plugins": [
      "stylelint-scss"
    ],
    "extends": [
      "stylelint-config-recommended-scss"
    ],
    "rules": {}
  }
}
